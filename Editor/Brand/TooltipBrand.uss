/* Exact slate accent (#8B8D98) of Basic Tooltip. The selectors repeat the kit's accent-preset selectors on purpose: a
   single ".vn-root" rule has lower specificity than ".vn-root.vn-accent--slate" and would lose to it. */
.vn-root,
.vn-root.vn-accent--slate {
    --vn-accent: #8B8D98;
    --vn-accent-soft: rgba(139, 141, 152, 0.16);
    --vn-accent-line: rgba(139, 141, 152, 0.55);
    --vn-pressed: rgba(139, 141, 152, 0.24);
}

.vn-root.vn-root--light,
.vn-root.vn-root--light.vn-accent--slate {
    --vn-accent: #5E606B;
    --vn-accent-soft: rgba(94, 96, 107, 0.14);
    --vn-accent-line: rgba(94, 96, 107, 0.60);
    --vn-pressed: rgba(94, 96, 107, 0.22);
}
